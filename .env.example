# Names only. Values come from Google Secret Manager, not GitHub settings.
# Deployment configuration (never sent to the browser or Worker runtime)
DEPLOY_ENABLED=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
APP_URL=

# Migration/operator access (not sent to the browser or Worker runtime)
MIGRATION_DATABASE_URL=

# Browser configuration (VITE_* values are public in the built application)
VITE_API_BASE=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_MAPTILER_KEY=
VITE_MAP_STYLE_URL=

# Worker runtime configuration and secrets
APP_ENV=
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL_ID=
MEDIA_SIGNING_SECRET=
VOTE_RADIUS_M=
MAX_GPS_ACCURACY_M=
LOCATION_MAX_AGE_SECONDS=
REPORTER_REWARD_RP=
GREEN_CLEANER_REWARD_RP=
PHOTO_MAX_BYTES=
AI_RATE_PER_MINUTE=
DEMO_DATA=
